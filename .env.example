# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/dars_jadval_db?schema=public"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth (NextAuth v5) — "openssl rand -base64 32" bilan generatsiya qiling
AUTH_SECRET="your_auth_secret_here_at_least_32_chars"

# AI Provider API Key (Gemini, Claude or OpenAI)
AI_API_KEY="your_api_key_here"
AI_PROVIDER="gemini" # gemini | anthropic | openai

# Telegram Bot Integration (Zamena alerts & notifications)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_WEBHOOK_SECRET="your_webhook_secret"

# Redis Cache (Optional — Docker Compose'da bor)
REDIS_URL="redis://localhost:6379"
